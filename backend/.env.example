# ===== 大模型（阿里云百炼 / DashScope 原生 SDK，必填）=====
# Key 在 https://bailian.console.aliyun.com/ 的「API-KEY 管理」获取
LLM_API_KEY=your_dashscope_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1
CHAT_MODEL=qwen-plus
# 开启思考：返回 reasoning_content（思考过程）与 content（最终输出）两类结果
ENABLE_THINKING=true

# ===== Embedding（RAG / 长期记忆能力需要，与百炼共用同一 Key，可选）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 混合检索（advanced RAG 方案）的稀疏向量模型
SPARSE_EMBEDDING_MODEL=text-sparse-embedding-v1

# ===== 检索后端（RAG 向量库；不配 Qdrant/ES 则回退内存检索）=====
# 后端选型：qdrant（默认）| elasticsearch | memory（强制内存，离线/测试）
RAG_STORE_BACKEND=qdrant

# --- Qdrant Cloud ---
# 在 Qdrant Cloud 控制台创建集群后，填入公网 URL 与 API Key
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=knowledge   # 集合名 = {prefix}_{scheme_id}，如 knowledge_naive
QDRANT_EMBEDDING_DIM=1024            # text-embedding-v3 默认维度

# --- Elasticsearch（RAG_STORE_BACKEND=elasticsearch 时生效）---
# ES dense_vector kNN 相似度检索；advanced 方案额外用 text 字段 BM25 做多路召回（RRF 融合）
ES_URL=
ES_API_KEY=            # 或用用户名/密码认证（填了 username+password 则优先生效）
ES_USERNAME=
ES_PASSWORD=
ES_INDEX_PREFIX=knowledge   # 索引名 = {prefix}_{scheme_id}，如 knowledge_advanced
ES_EMBEDDING_DIM=1024

RAG_SCHEMES=["naive","advanced"]  # 已注册的 RAG 方案（每方案独立集合；modular/graph/agentic 后续扩展）
RAG_DEFAULT_SCHEME=naive          # 默认方案

# ===== MCP Servers（可选，默认关闭）=====
# MCP_ENABLED=false：默认只注册不连接；开启请在页面侧边栏「MCP 服务」开关点选（POST /api/mcp）
# JSON 数组/对象，每个 server 支持两种形式：
#   stdio:  {"name": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}}
#   streamable HTTP: {"name": {"url": "http://localhost:8000/mcp", "headers": {}}}
# 本项目自带 mcp-notes 便签 server（Streamable HTTP），先启动：
#   uvicorn app.mcp_server.notes_server:app --port 8001
MCP_ENABLED=false
MCP_SERVERS={"mcp-notes": {"url": "http://127.0.0.1:8001/mcp"}}

# ===== 运行参数 =====
MAX_ITERATIONS=8
RAG_TOP_K=3
CONTEXT_THRESHOLD=12
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# ===== 重试机制 =====
# 工具层直接重试（透明重试）：仅对瞬时错误（超时/连接重置/服务端5xx/限流429）用相同参数重试，模型无感知
TOOL_RETRY_MAX=3            # 直接重试最大次数
TOOL_RETRY_BASE_DELAY=1.5   # 退避基础秒数（每次×2，上限封顶）；默认放大便于观察退避过程
TOOL_RETRY_MAX_DELAY=8.0    # 单次重试最长退避秒数
AGENT_RETRY_MAX=3           # Agent 层：同一工具连续失败达到该次数后，提示模型改用其它工具

# ===== 每日对话配额（部署防滥用，可选）=====
# 限制「一台电脑 / 一个 IP」每天的对话次数：前端会下发 X-Client-Id 设备指纹精确区分电脑，
# 无指纹时按 IP 计数；超过上限返回 429。计数按自然日清零，跨天自动重置。
QUOTA_ENABLED=true
QUOTA_DAILY_LIMIT=20            # 每客户端每天最多发起对话次数
QUOTA_STORE_PATH=./data/quota.json  # 计数持久化文件（留空 = 仅内存，重启清零）

# ===== 命令执行沙箱（run_command 工具）=====
# sandbox_backend: opensandbox（默认，连接 Docker 部署的 OpenSandbox）| local（本机轻量沙箱兜底）
SANDBOX_BACKEND=opensandbox
SANDBOX_TIMEOUT=10
SANDBOX_MAX_OUTPUT=4000
# 沙箱/宿主机共享工作目录：沙箱写入的文件持久化到此目录，前端「沙箱文件」面板可点击下载。
# - opensandbox 后端：以 Volume 挂载进沙箱，需在 OpenSandbox 服务端 [storage].allowed_host_paths 放行该路径；
# - local 后端：直接作为命令工作目录。
SANDBOX_WORK_DIR=./data/sandbox-work
SANDBOX_MOUNT_TARGET=/work
# OpenSandbox 服务端由你自行部署，这里填服务地址与鉴权
OPENSANDBOX_DOMAIN=localhost:8090
OPENSANDBOX_PROTOCOL=http
OPENSANDBOX_API_KEY=
OPENSANDBOX_IMAGE=ubuntu:22.04
