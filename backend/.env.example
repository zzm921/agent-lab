# ===== 大模型（阿里云百炼 / DashScope 原生 SDK，必填）=====
# Key 在 https://bailian.console.aliyun.com/ 的「API-KEY 管理」获取
LLM_API_KEY=your_dashscope_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/api/v1
CHAT_MODEL=qwen-plus
# 开启思考：返回 reasoning_content（思考过程）与 content（最终输出）两类结果
ENABLE_THINKING=true

# ===== Embedding（RAG / 长期记忆能力需要，与百炼共用同一 Key，可选）=====
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ===== MCP Servers（可选）=====
# JSON 数组/对象，每个 server 支持两种形式：
#   stdio:  {"name": {"command": "npx", "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]}}
#   streamable HTTP: {"name": {"url": "http://localhost:8000/mcp", "headers": {}}}
MCP_SERVERS={}

# ===== 运行参数 =====
MAX_ITERATIONS=8
RAG_TOP_K=3
CONTEXT_THRESHOLD=12
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]
